<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>$(STATEFLOWS_VERSION)</Version>
    <Authors>Stateflows</Authors>
    <Description>JSON state-machine, activity and structural event definitions for Stateflows.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Stateflows\Stateflows.csproj" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="state-machine.schema.json" />
    <EmbeddedResource Include="activity.schema.json" />
    <EmbeddedResource Include="event.schema.json" />
    <None Update="state-machine.schema.json" Pack="true" PackagePath="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Update="activity.schema.json" Pack="true" PackagePath="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Update="event.schema.json" Pack="true" PackagePath="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="StateMachine.IntegrationTests" />
  </ItemGroup>
</Project>
