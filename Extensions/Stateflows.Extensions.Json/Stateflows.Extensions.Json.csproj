<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <Nullable>enable</Nullable>
      <ImplicitUsings>enable</ImplicitUsings>
      <Title>JSON extension for Stateflows framework</Title>
      <Version>$(STATEFLOWS_VERSION)</Version>
      <Authors>Stateflows</Authors>
      <PackageProjectUrl>https://www.stateflows.net</PackageProjectUrl>
      <PackageIcon>stateflows-logo-1024.png</PackageIcon>
      <RepositoryUrl>https://github.com/Stateflows/framework</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <PackageTags>Stateflows;state-machine;activity;workflow;JSON</PackageTags>
      <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageLicenseFile>LICENSE</PackageLicenseFile>
      <PackageOutputPath>..\..\NuGet</PackageOutputPath>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <LangVersion>default</LangVersion>
  </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\stateflows-logo-1024.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Stateflows\Stateflows.csproj" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="state-machine.schema.json" />
    <EmbeddedResource Include="activity.schema.json" />
    <EmbeddedResource Include="event.schema.json" />
    <None Update="state-machine.schema.json" Pack="true" PackagePath="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Update="activity.schema.json" Pack="true" PackagePath="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Update="event.schema.json" Pack="true" PackagePath="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="StateMachine.IntegrationTests" />
  </ItemGroup>
</Project>
