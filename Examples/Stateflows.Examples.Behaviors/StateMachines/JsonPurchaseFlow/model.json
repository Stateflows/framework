{
  "$schema": "urn:stateflows:state-machine:1.0",
  "formatVersion": "1.0",
  "name": "JsonPurchaseFlow",
  "version": 1,
  "initial": "AwaitingPurchase",
  "vertices": [
    {
      "kind": "state",
      "name": "AwaitingPurchase",
      "onEntry": [
        {
          "clrType": "purchase.stateHandler",
          "configuration": "Waiting for a purchase submission."
        }
      ],
      "onExit": [
        {
          "clrType": "purchase.stateHandler",
          "configuration": "Leaving the purchase waiting state."
        }
      ],
      "transitions": [
        {
          "kind": "event",
          "triggers": [
            { "clrType": "purchase.submitted" }
          ],
          "target": "Completed",
          "effects": [
            {
              "clrType": "purchase.effect",
              "configuration": "Purchase accepted."
            }
          ],
          "metadata": {
            "description": "Accept a purchase."
          }
        },
        {
          "kind": "event",
          "triggers": [
            { "clrType": "purchase.cancelled" }
          ],
          "target": "Cancelled",
          "effects": [
            {
              "clrType": "purchase.effect",
              "configuration": "Purchase cancelled."
            }
          ],
          "metadata": {
            "description": "Cancel a purchase."
          }
        }
      ]
    },
    {
      "kind": "final",
      "name": "Completed",
      "metadata": {
        "outcome": "completed"
      }
    },
    {
      "kind": "final",
      "name": "Cancelled",
      "metadata": {
        "outcome": "cancelled"
      }
    }
  ]
}
