{
  "name": "@stateflows/visualizer",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "files": ["dist"],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "svelte": "./dist/index.js", "default": "./dist/index.js" }
  },
  "scripts": {
    "demo": "npm run build && dotnet run --project ..\\Stateflows.Tools.Visualizer.DevHost\\Stateflows.Tools.Visualizer.DevHost.csproj --launch-profile Visualizer -p:GeneratePackageOnBuild=false",
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "package": "svelte-package -i src/lib -o dist",
    "build": "npm run check && npm run package && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@xyflow/svelte": "1.7.1",
    "elkjs": "0.12.1"
  },
  "peerDependencies": { "svelte": "^5.0.0" },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "^24.10.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "~6.0.3",
    "vite": "7.2.2",
    "vitest": "4.0.18"
  }
}
